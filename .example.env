VITE_EXAMPLE=example

# Chrome Web Store API credentials for `pnpm release` (see CHROMEWEBSTORE.md).
# Copy these into a root .env file (gitignored). Never commit real values.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_PUBLISHER_ID=
# Optional: defaults to the Unfolks item id.
# CWS_EXTENSION_ID=idgjpjkoddplmbdepekendpdbaibcgpc

# Sentry source map upload, run by `pnpm zip` and required by `pnpm release`.
# An organization auth token with release access (Settings > Auth Tokens).
SENTRY_AUTH_TOKEN=
# Optional: default to the Unfolks organization and project.
# SENTRY_ORG=
# SENTRY_PROJECT=
# Optional: only needed with a personal token, e.g. https://de.sentry.io
# SENTRY_URL=
